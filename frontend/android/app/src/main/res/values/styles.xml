<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
        <item name="android:colorPrimaryDark">@color/primaryContrast</item>
    </style>
    
    <style name="SplashTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@drawable/background_splash</item>
        <item name="android:statusBarColor">@color/primaryContrast</item>
        <item name="android:navigationBarColor">@color/primaryContrast</item>
    </style>

    <style name="SecondSplash" parent="SplashScreen_SplashTheme">
        <item name="android:statusBarColor">@color/primaryContrast</item>
        <item name="android:navigationBarColor">@color/primaryContrast</item>
    </style>
</resources>
